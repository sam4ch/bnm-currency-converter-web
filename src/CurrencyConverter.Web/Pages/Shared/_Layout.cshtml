<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Конвертер валют BNM</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="app-header">
        <div class="header-container">
            <div class="logo">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path>
                    <path d="M12 6v2"></path>
                    <path d="M12 16v2"></path>
                </svg>
                <span>Конвертер валют</span>
            </div>
            <div class="header-badge">Официальный курс НБМ</div>
        </div>
    </header>

    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="footer-container">
            <span>Источник данных: <a href="https://www.bnm.md/en/official_exchange_rates" target="_blank" rel="noopener noreferrer">Национальный банк Молдовы (BNM)</a></span>
            <span class="footer-note">Курсы являются официальными справочными значениями</span>
        </div>
    </footer>

    <script src="~/js/site.js"></script>
</body>
</html>
